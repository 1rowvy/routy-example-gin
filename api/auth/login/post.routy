// Exchanges email and password for a bearer token that lives for an hour.
// gin internal/api/router.go:24 → s.Login
//
// Every request behind AuthRequired calls `Login()` in its headers. Within one
// run it is sent once; `cache: 50m` keeps the token between runs too.
Login: POST /auth/login {
  handler: s.Login

  params {
    email: admin_email
    password: admin_password
  }

  cache: 50m
  body { email, password }

  expect {
    status == 200
    body matches Token
    body.expires_in == 3600
  }
}

// A negative test: only its method and path are compared with the code.
LoginWithWrongPassword: POST /auth/login {
  body { email: admin_email, password: "nope" }

  expect {
    status == 401
    body.error == "wrong email or password"
  }
}
