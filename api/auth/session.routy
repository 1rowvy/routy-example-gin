// Start session
// Browser-style login: a form post that sets the `session` cookie.
// gin internal/api/router.go:25 → s.StartSession
POST /auth/session {
  handler: s.StartSession

  form {
    email: admin_email
    password: admin_password
  }

  expect {
    status == 204
    cookies.session != null
  }
}

// Me
// The user of the current session. The cookie comes from the run's cookie jar,
// so this works right after `Start session` — no token, nothing saved by hand.
// gin internal/api/router.go:26 → s.Me
// middleware: SessionRequired(s)
GET /auth/me {
  handler: s.Me

  expect {
    status == 200
    body matches User
    body.email == admin_email
  }
}
