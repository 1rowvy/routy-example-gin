// Multipart form with an image in the `file` field.
// gin internal/api/users.go:15 → s.UploadAvatar
// middleware: AuthRequired(s)
UploadAvatar: POST /v1/users/{id}/avatar {
  handler: s.UploadAvatar
  params { id: CreateUser().body.id }
  headers { Authorization: "Bearer ${Login().body.token}" }
  multipart { file: file("./avatar.png") }

  expect {
    status == 200
    body matches User
    body.avatar == "/avatars/avatar.png"
  }
}
