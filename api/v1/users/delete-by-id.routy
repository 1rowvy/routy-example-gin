// Admins only. Limited to dev and asks before sending: `routy run` prompts in a
// terminal, `--yes` skips the prompt in CI, the app shows a dialog.
// gin internal/api/users.go:16 → s.DeleteUser
// middleware: AuthRequired(s), AdminOnly()
DeleteUser: DELETE /v1/users/{id} {
  handler: s.DeleteUser
  params { id: CreateUser(name: "Temp").body.id }
  only: [dev]
  confirm: true
  headers { Authorization: "Bearer ${Login().body.token}" }
  expect { status == 204 }
}

// Logs in as a freshly created customer: calls take arguments.
DeleteUserAsCustomer: DELETE /v1/users/1 {
  headers {
    Authorization: "Bearer ${Login(email: CreateUser().body.email, password: "customer").body.token}"
  }

  expect {
    status == 403
    body.error == "admins only"
  }
}
