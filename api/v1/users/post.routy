// The email must be unique; the role defaults to "customer".
// gin internal/api/users.go:13 → s.CreateUser
// middleware: AuthRequired(s)
//
// Call it from other requests to get a fresh customer: `CreateUser().body.id`.
CreateUser: POST /v1/users {
  handler: s.CreateUser

  params {
    name: "Ann Lee"
    email: "ann.${randomString(8).lower()}@shop.test"
    role: "customer"
  }

  headers { Authorization: "Bearer ${Login().body.token}" }
  body { name, email, role }

  expect {
    status == 201
    body matches User
    body.email == email
    body.avatar == null
  }

  save user_id = body.id
}

// `binding:"required"` in Go turns into a 400.
CreateUserWithoutEmail: POST /v1/users {
  headers { Authorization: "Bearer ${Login().body.token}" }
  body { name: "No Email" }

  expect {
    status == 400
    body.error.contains("Email")
  }
}
