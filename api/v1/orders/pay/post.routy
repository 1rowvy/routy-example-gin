// Pay order
// Payment is asynchronous: the order becomes "pending" and turns "paid" a moment later.
// gin internal/api/orders.go:16 → s.PayOrder
// middleware: AuthRequired(s)
POST /v1/orders/{id}/pay {
  handler: s.PayOrder
  params { id: CreateOrder().body.id }
  headers { Authorization: "Bearer ${Login().body.token}" }

  expect {
    status == 202
    body matches Order
    body.status == "pending"
  }
}

// Wait until paid
// Repeats the request until the payment provider confirms the order.
GET /v1/orders/{id} {
  params { id: PayOrder().body.id }
  headers { Authorization: "Bearer ${Login().body.token}" }
  poll body.status == "paid" every 300ms for 10s

  expect {
    body matches Order
    body.paid_at != null
  }
}
